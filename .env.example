# ==========================================
# YourFindJob Environment Configuration
# ==========================================

# MongoDB Database Configuration (Primary Storage)
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=yourfindjob_db
MONGODB_TIMEOUT_MS=3000

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Gmail Notification Configuration (Option 1: Gmail App Password - Easiest & Headless)
GMAIL_SENDER_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
GMAIL_RECIPIENT_EMAIL=your_email@gmail.com

# Gmail Notification Configuration (Option 2: Google OAuth2 - Optional)
GOOGLE_OAUTH_CREDENTIALS_FILE=credentials.json
GOOGLE_OAUTH_TOKEN_FILE=token.json

# Optional Agent Settings
DRY_RUN=false
MAX_JOBS=30
